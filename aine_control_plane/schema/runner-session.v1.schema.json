{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/control-plane/runner-session.v1.schema.json",
  "title": "AINE Control Plane Runner Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "revision", "status", "execution_id", "plan_id", "runner_kind", "operation_profile", "project_ids", "patch_artifact_ids", "validation_report_ids", "evidence_ids", "requested_by", "created_at", "mutation_scope", "read_only"],
  "properties": {
    "schema": {"const": "aine.control-plane.runner-session.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["requested", "running", "completed", "failed", "unknown", "conflict", "cancelled", "closed"]},
    "execution_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "runner_kind": {"const": "local_runner"},
    "operation_profile": {"enum": ["dry_run_patch", "validation_only"]},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "project_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "patch_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_report_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workspace_ref": {
      "type": "string",
      "allOf": [
        {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"},
        {"not": {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*@"}},
        {"not": {"pattern": "[?#]"}},
        {"not": {"pattern": "^[Ff][Ii][Ll][Ee]:"}}
      ]
    },
    "requested_by": {"type": "string", "minLength": 1},
    "authenticated_actor": {"type": ["string", "null"]},
    "claimed_actor": {"type": ["string", "null"]},
    "actor_source": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "reported_at": {"type": "string"},
    "reported_by": {"type": "string"},
    "updated_at": {"type": "string"},
    "previous_revision": {"type": "integer", "minimum": 1},
    "result": {"type": "object"},
    "mutation_scope": {
      "type": "object",
      "required": ["source_repositories", "git", "deployment"],
      "properties": {
        "source_repositories": {"const": false},
        "git": {"const": false},
        "deployment": {"const": false}
      },
      "additionalProperties": false
    },
    "read_only": {"const": true}
  }
}
