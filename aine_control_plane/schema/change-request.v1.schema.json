{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/control-plane/change-request.v1.schema.json",
  "title": "AINE Control Plane Change Request v1",
  "type": "object",
  "required": [
    "schema",
    "change_id",
    "revision",
    "status",
    "change_type",
    "title",
    "description",
    "scope",
    "requested_by",
    "owner",
    "acceptance_criteria",
    "source_of_truth",
    "evidence_ids",
    "risk",
    "approval_required",
    "created_at",
    "read_only"
  ],
  "properties": {
    "schema": {"const": "aine.control-plane.change-request.v1"},
    "change_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "submitted", "approved", "rejected", "closed"]},
    "change_type": {"enum": ["feature", "fix", "requirement", "project_registration"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "requested_by": {"type": "string", "minLength": 1},
    "authenticated_actor": {"type": ["string", "null"]},
    "claimed_actor": {"type": ["string", "null"]},
    "actor_source": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "source_of_truth": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "risk": {"enum": ["low", "medium", "high"]},
    "approval_required": {"type": "boolean"},
    "created_at": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string"},
    "previous_revision": {"type": "integer", "minimum": 1},
    "approval_id": {"type": "string"},
    "read_only": {"const": true}
  }
}
