{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/control-plane/validation-report.v1.schema.json",
  "title": "AINE Control Plane Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "report_id", "revision", "status", "session_id", "execution_id", "plan_id", "summary", "checks", "evidence_ids", "runner_kind", "reported_by", "created_at", "mutation_scope", "read_only"],
  "properties": {
    "schema": {"const": "aine.control-plane.validation-report.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pass", "fail", "unknown", "conflict"]},
    "session_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "summary": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "status", "summary"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unknown", "conflict"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "missing_check_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "runner_kind": {"const": "local_runner"},
    "reported_by": {"type": "string", "minLength": 1},
    "authenticated_actor": {"type": ["string", "null"]},
    "claimed_actor": {"type": ["string", "null"]},
    "actor_source": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "mutation_scope": {
      "type": "object",
      "required": ["source_repositories", "git", "deployment"],
      "properties": {
        "source_repositories": {"const": false},
        "git": {"const": false},
        "deployment": {"const": false}
      },
      "additionalProperties": false
    },
    "read_only": {"const": true}
  }
}
